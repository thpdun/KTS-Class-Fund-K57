  <div class="modal-overlay" id="walletModal">
    <div class="modal-box">
      <div class="modal-header">
        <h3 id="modalTitle">Thông báo hệ thống</h3>
        <button class="modal-close" onclick="closeModal()">&times;</button>
      </div>
      <div id="modalBody" style="font-size: 0.95rem; line-height: 1.7; color: var(--text-main);"></div>
      <div style="margin-top: 24px; text-align: right;" id="modalFooter">
