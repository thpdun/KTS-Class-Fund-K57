        </div>
        <span class="badge-topbar-role" id="topbarRoleBadge" style="display:none;"></span>
        <button class="btn btn-warning btn-sm" id="btnVerifyWalletAuth" style="display:none; padding:4px 10px; font-size:0.8rem;" onclick="authenticateWalletSession(true)" title="Ký thông điệp xác thực bảo mật để mở khóa vai trò BCS/Cố vấn và bảo vệ thông tin sinh viên">🔑 Ký xác thực</button>
        <button class="btn btn-primary btn-sm" id="btnConnectWallet" title="Bấm để kết nối hoặc đổi tài khoản">
          <svg style="width:16px;height:16px;fill:currentColor;" viewBox="0 0 24 24">
            <path
              d="M21 7.28V5c0-1.1-.9-2-2-2H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-2.28c.59-.35 1-.98 1-1.72V9c0-.74-.41-1.37-1-1.72zM20 9v6h-7V9h7zM5 19V5h14v2h-6c-1.1 0-2 .9-2 2v6c0 1.1.9 2 2 2h6v2H5z" />
          </svg>
          <span id="walletBtnText">Kết nối MetaMask</span>
        </button>
        <button class="btn btn-outline btn-sm" id="btnSwitchWallet" style="display:none;"
          title="Đổi sang tài khoản ví khác" onclick="switchAccount()">
          🔄 Đổi ví
        </button>
        <button class="btn btn-danger btn-sm" id="btnDisconnectWallet" style="display:none; padding:6px 10px;"
          title="Ngắt kết nối ví" onclick="disconnectWallet()">
          ✕
        </button>
      </div>
    </header>

    <!-- Main Content -->
    <main class="app-content">
      <!-- HERO & DASHBOARD OVERVIEW -->
      <section class="hero-section" id="hero">
        <div class="hero-banner-card">
          <div class="hero-tag">
            <span>●</span> Cổng Thông Tin &amp; Quản Lý Quỹ Lớp Blockchain Chuẩn Mực ECO2432
          </div>
          <h1 class="hero-title">KTS CLASS FUND — Minh bạch hóa quản lý quỹ lớp bằng Blockchain</h1>
          <p class="hero-desc">
            Hệ thống quản lý đóng góp, giải ngân chi tiêu và đối soát giao dịch thời gian thực thông qua hợp đồng thông
            minh Ethereum Sepolia, giúp toàn thể sinh viên K57 giám sát dòng tiền minh bạch.
          </p>
        </div>

        <!-- Quick Control Bar (Address, Role, Student Identity, Contract Config) -->
        <div class="quick-control-bar">
          <div class="quick-status-group">
            <!-- Ô 1: Địa chỉ ví đang kết nối -->
            <div class="quick-status-item">
              <span class="quick-status-label">Địa chỉ ví đang kết nối</span>
              <div class="quick-status-body">
                <span class="quick-status-val" id="quickWalletAccount" style="font-family: monospace;">Chưa kết nối ví</span>
                <div class="quick-status-actions">
                  <button class="btn btn-sm btn-outline" id="btnQuickSwitch"
                    style="display:none;" onclick="switchAccount()">🔄 Đổi ví</button>
                  <button class="btn btn-sm btn-outline" id="btnQuickDisconnect"
                    style="display:none;" onclick="disconnectWallet()">Đăng xuất</button>
                </div>
              </div>
            </div>

            <!-- Ô 2: Vai trò xác thực -->
            <div class="quick-status-item">
              <span class="quick-status-label">Vai trò xác thực</span>
              <div class="quick-status-body">
                <div>
                  <span class="status-pill status-ready" id="quickRoleBadge">Chưa kết nối</span>
                </div>
              </div>
            </div>

            <!-- Ô 3: Định danh sinh viên K57 -->
            <div class="quick-status-item">
              <span class="quick-status-label">Định danh sinh viên K57</span>
              <div class="quick-status-body">
                <span class="quick-status-val" id="quickStudentIdentity"
                  style="color: #0284c7; font-weight: 600;">--</span>
              </div>
            </div>
            <span id="quickNetworkStatus" style="display: none;"></span>
          </div>

          <!-- Quick Contract Input & Actions Toolbar Row -->
          <div class="contract-toolbar-row">
            <div class="contract-input-bar">
              <svg style="width:16px;height:16px;fill:#38bdf8;" viewBox="0 0 24 24">
                <path
                  d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z" />
              </svg>
              <input type="text" id="quickContractAddress" placeholder="Dán địa chỉ Hợp đồng (0x...)">
            </div>
            <button class="btn btn-sm btn-primary" id="btnSaveQuickContract" title="Lưu và tải hợp đồng">Lưu &amp; Tải</button>
            <button class="btn btn-sm btn-outline" id="btnResetQuickContract" onclick="resetToDefaultContract()"
              title="Khôi phục địa chỉ hợp đồng mặc định của dự án">🔄 Đặt lại</button>

            <!-- Nút Quản lý Danh bạ K57 (Chỉ hiện khi BCS hoặc CVHT đăng nhập) -->
            <div class="quick-status-item-btn" id="itemRosterModalBtn" style="display: none; margin-left: auto;">
              <button class="btn btn-sm btn-outline" id="btnOpenRosterModal" onclick="openRosterModal()"
                style="font-size:0.8rem; padding:6px 12px; display:inline-flex; align-items:center; gap:6px; background:#ffffff; color:var(--primary-navy); border-color:var(--border-color);"
                title="Chỉ Ban cán sự và Cố vấn học tập mới có quyền mở">
                <span>📋</span> Quản lý Danh bạ K57 (<span id="rosterCountBadge">7</span>)
              </button>
            </div>
          </div>
        </div>

        <!-- CẢNH BÁO KHÁCH VÃNG LAI (GUEST WARNING BANNER) -->
        <div id="guestWarningBanner"
          style="display: none; margin-top: 14px; background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.4); border-radius: var(--radius-md); padding: 12px 18px; color: #fde68a; font-size: 0.88rem; align-items: center; justify-content: space-between; gap: 12px;">
          <div style="display: flex; align-items: center; gap: 10px;">
            <span style="font-size: 1.3rem;">⚠️</span>
            <div>
              <strong>Địa chỉ ví của bạn chưa được liên kết với Danh bạ sinh viên K57.</strong>
              <div style="font-size: 0.8rem; color: #fef3c7; opacity: 0.9;">Hệ thống đang mở ở chế độ <strong>Khách vãng
                  lai (Chỉ xem)</strong>. Để được định danh theo Tên & MSSV khi nộp quỹ và biểu quyết, vui lòng liên hệ
                Ban cán sự hoặc Cố vấn học tập.</div>
            </div>
          </div>
        </div>

        <!-- BẢNG THÔNG BÁO THU QUỸ LỚP (CLASS ANNOUNCEMENT BANNER) -->
        <div class="class-announcement-card" id="classAnnouncementCard">
          <div class="ann-header">
            <div class="ann-tag-group">
              <span class="ann-badge-pill">📢 THÔNG BÁO QUỸ LỚP</span>
              <span class="ann-status-tag" id="annStatusTag"><span class="ann-dot-pulse"></span> <span
                  id="annStatusText">Đang diễn ra</span></span>
            </div>
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
              <button class="btn btn-sm btn-outline-light" id="btnToggleAnnHistory" type="button"
                title="Xem lịch sử các đợt thu quỹ lớp trước đây">
                📜 Lịch sử thông báo (<span id="annHistoryCountBadge">0</span>)
              </button>
              <button class="btn btn-sm btn-outline-light" id="btnOpenAnnModal" style="display: none;"
                title="Chỉ Ban cán sự mới có quyền sửa">
                ✏️ Quản trị thông báo (BCS)
              </button>
            </div>
          </div>

          <div class="ann-body">
            <h2 class="ann-title" id="annTitle">Kêu gọi nộp Quỹ Lớp Học kỳ 1 - Khóa K57 Kinh tế Số</h2>
            <p class="ann-purpose" id="annPurpose">Kinh phí phục vụ tài liệu học tập, các buổi sinh hoạt chuyên đề ngoại
              khóa và quỹ dự phòng hỗ trợ sinh viên K57.</p>

            <div class="ann-meta-grid">
              <div class="ann-meta-item">
                <span class="ann-meta-label">💰 Mức đóng quy định:</span>
                <span class="ann-meta-val" id="annAmount">0.0100 ETH / bạn</span>
              </div>
              <div class="ann-meta-item">
                <span class="ann-meta-label">⏳ Hạn chót nộp:</span>
                <span class="ann-meta-val" id="annDeadline">23:59 ngày 15/11/2026</span>
              </div>
              <div class="ann-meta-item">
                <span class="ann-meta-label">👥 Sĩ số lớp:</span>
                <span class="ann-meta-val" id="annClassSize">-- sinh viên</span>
              </div>
            </div>

            <div class="ann-progress-section">
              <div class="ann-progress-header">
                <span>Tiến độ thu quỹ toàn lớp:</span>
                <strong id="annProgressText">0/-- bạn đã nộp (0%)</strong>
              </div>
              <div class="ann-progress-track">
                <div class="ann-progress-fill" id="annProgressBar" style="width: 0%;"></div>
              </div>
            </div>

            <!-- Phân biệt rạch ròi: Trạng thái cá nhân vs Trạng thái cả lớp (Đợt 3B.3) -->
            <div class="ann-personal-status-box" id="annPersonalStatusBox"
              style="margin-top: 14px; padding: 10px 14px; background: #ffffff; border-radius: var(--radius-md); border: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
              <div style="font-size: 0.88rem; display: flex; align-items: center; gap: 8px;">
                <span style="font-weight: 600; color: var(--primary-navy);">👤 Nghĩa vụ cá nhân:</span>
                <span id="annPersonalStatusBadge" class="task-badge status-unverified">Chưa kết nối ví</span>
              </div>
              <span id="annPersonalStatusDesc" style="font-size: 0.82rem; color: var(--text-muted);">Kết nối ví MetaMask để kiểm tra trạng thái đóng góp của bạn</span>
            </div>
          </div>

          <div class="ann-footer">
            <button class="btn btn-primary" id="btnBannerQuickDeposit">
              ⚡ Nộp quỹ ngay (0.01 ETH)
            </button>
            <span class="ann-tip">💡 Sinh viên có thể bấm nộp trực tiếp hoặc hỏi Trợ lý AI để tra cứu thông tin chi tiết
              về đợt thu này.</span>
          </div>
        </div>

        <!-- MỤC LỊCH SỬ THÔNG BÁO THU QUỸ ĐÃ HOÀN THÀNH / LƯU TRỮ -->
        <div class="class-announcement-card" id="annHistoryCard" style="display: none; margin-top: 14px; background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 18px 20px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; border-bottom: 1px solid #e2e8f0; padding-bottom: 10px;">
            <h3 style="margin: 0; font-size: 1.05rem; color: var(--primary-navy); display: flex; align-items: center; gap: 8px;">
              📁 Lịch sử các đợt kêu gọi nộp Quỹ Lớp K57
            </h3>
            <button class="btn btn-sm btn-secondary" id="btnCloseAnnHistory" type="button">✖ Đóng</button>
          </div>
          <div id="annHistoryListContainer" style="display: flex; flex-direction: column; gap: 12px;">
            <!-- Danh sách các thông báo cũ -->
          </div>
        </div>

        <!-- Live metrics ribbon -->
        <div class="metrics-grid">
          <div class="metric-card">
            <div class="metric-title">Số dư Quỹ lớp (99%)</div>
            <div class="metric-num" id="metricClassFund">- ETH</div>
            <div class="metric-note" id="metricClassFundNote">Chờ cấu hình hợp đồng</div>
          </div>
          <div class="metric-card">
            <div class="metric-title">Quỹ phí vận hành (1%)</div>
            <div class="metric-num" id="metricAdminFee">- ETH</div>
            <div class="metric-note" id="metricAdminFeeNote">Bù đắp gas cho Cố vấn học tập</div>
          </div>
          <div class="metric-card">
            <div class="metric-title">Sinh viên đã nộp quỹ</div>
            <div class="metric-num" id="metricDepositorsCount">-</div>
            <div class="metric-note" id="metricDepositorsNote">Đồng bộ từ blockchain</div>
          </div>
          <div class="metric-card">
            <div class="metric-title">Tổng đề nghị chi tiền</div>
            <div class="metric-num" id="metricSpendCount">-</div>
            <div class="metric-note">Biểu quyết dân chủ tối thiểu 51%</div>
          </div>
          <div class="metric-card">
            <div class="metric-title">Tổng yêu cầu hoàn tiền</div>
            <div class="metric-num" id="metricRefundCount">-</div>
            <div class="metric-note">Bảo vệ quyền lợi khi nộp nhầm</div>
          </div>
          <div class="metric-card">
            <div class="metric-title">Ban cán sự hoạt động</div>
            <div class="metric-num" id="metricActiveBCS">-</div>
            <div class="metric-note" id="metricActiveBCSNote">Cố vấn học tập quản trị (R1)</div>
          </div>
        </div>
      </section>

      <!-- KHU VỰC: VIỆC CẦN XỬ LÝ & TRẠNG THÁI CÁ NHÂN (ACTION CENTER) -->
      <section class="pending-actions-section" id="pendingActionsSection">
        <div class="pending-actions-card">
          <div class="pending-actions-header">
            <div class="pending-header-title">
              <span class="pending-header-icon">📌</span>
              <div>
                <h3 class="pending-title">Việc cần xử lý &amp; Trạng thái của bạn</h3>
                <p class="pending-subtitle">Tác vụ theo thời gian thực dựa trên trạng thái hợp đồng thông minh và vai trò đã xác thực</p>
              </div>
            </div>
            <div class="pending-header-actions">
              <span class="pending-count-badge all-clear" id="pendingCountBadge">0 việc cần xử lý</span>
              <button class="btn btn-sm btn-outline" onclick="refreshContractData()" title="Làm mới tác vụ on-chain">🔄 Cập nhật</button>
            </div>
          </div>
          <div class="pending-actions-list" id="pendingActionsList">
            <!-- Tự động kết xuất động theo trạng thái on-chain -->
            <div class="pending-all-clear">
              <div class="all-clear-icon">✨</div>
              <div class="all-clear-content">
                <h4>Đang tải dữ liệu tác vụ on-chain...</h4>
                <p>Hệ thống đang đồng bộ dữ liệu để kiểm tra các việc cần xử lý theo vai trò của bạn.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3 Ô GIAO DIỆN THEO 3 VAI TRÒ -->
      <section class="dapp-hero-section" id="dapp-workspace">
        <div class="container">
          <div class="workspace-role-header" style="text-align: center; max-width: 760px; margin: 0 auto 16px auto;">
            <span class="section-badge" style="background:#e0e7ff; color:var(--brand-blue); font-weight:700;">Không Gian
              Thao Tác</span>
            <h2 style="font-size: 2rem; color: var(--primary-navy); margin: 8px 0 6px 0;">
              Chọn Vai Trò Để Thao Tác
            </h2>
            <p style="font-size: 0.95rem; color: var(--text-muted);">
              Bấm chọn vai trò hoặc xem toàn bộ luồng dòng tiền để mở ô chi tiết:
            </p>

            <!-- 3 NÚT BẤM TRANG CHỦ THEO YÊU CẦU -->
            <div class="role-buttons-group">
              <button class="role-btn-item role-btn-student" id="btnRoleStudent" onclick="selectRoleView('student')">
                <span class="role-btn-icon">🎓</span>
                <span class="role-btn-label">Sinh viên</span>
              </button>
              <button class="role-btn-item role-btn-bcs" id="btnRoleBCS" onclick="selectRoleView('bcs')">
                <span class="role-btn-icon">👥</span>
                <span class="role-btn-label">Ban cán sự</span>
              </button>
              <button class="role-btn-item role-btn-advisor" id="btnRoleAdvisor" onclick="selectRoleView('advisor')">
                <span class="role-btn-icon">🛡️</span>
                <span class="role-btn-label">Cố vấn học tập</span>
              </button>
              <button class="role-btn-item role-btn-history" id="btnRoleHistory" onclick="selectRoleView('history')">
                <span class="role-btn-icon">📊</span>
                <span class="role-btn-label">Lịch sử dòng tiền</span>
              </button>
            </div>

            <div id="roleDetailHint"
              style="text-align: center; color: var(--text-muted); font-size: 0.92rem; margin-top: 10px;">
              💡 Bấm vào một trong 4 nút trên để mở ô chi tiết và theo dõi dòng tiền.
            </div>
          </div>

          <!-- KHUNG Ô CHI TIẾT (MẶC ĐỊNH CHỈ HIỆN KHI CHỌN VAI TRÒ) -->
          <div class="role-detail-container" id="roleDetailContainer" style="display: none;">

            <!-- ======================================================== -->
            <!-- Ô 1: GIAO DIỆN SINH VIÊN (STUDENT)                       -->
            <!-- ======================================================== -->
            <div class="role-panel panel-student" id="panelStudent" style="display: none;">
              <div class="panel-header" style="display: flex; justify-content: space-between; align-items: center;">
                <div class="panel-title" style="color: #047857; display: flex; align-items: center; gap: 8px;">
                  <svg style="width:24px;height:24px;fill:currentColor;" viewBox="0 0 24 24">
                    <path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zM5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82z" />
                  </svg>
                  <strong style="font-size: 1.25rem;">Ô Chi Tiết: Dành Cho Sinh Viên</strong>
                </div>
                <div style="display: flex; align-items: center; gap: 12px;">
                  <span class="panel-badge badge-student-role">Sinh viên K57</span>
                  <button class="btn btn-sm btn-outline" style="padding: 4px 12px; font-size: 0.85rem;"
                    onclick="closeRoleDetail()">✕ Thu gọn</button>
                </div>
              </div>

              <div class="panel-body">
                <!-- Đóng góp của bạn summary -->
                <div
                  style="background: #f8fafc; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 14px 16px;">
                  <div style="display:flex; justify-content:space-between; margin-bottom: 6px;">
                    <span style="font-size:0.85rem; color:var(--text-muted);">Tổng đóng góp của bạn:</span>
                    <strong style="color:var(--brand-blue);" id="myTotalContribution">0.0000 ETH</strong>
                  </div>
                  <div style="display:flex; justify-content:space-between; margin-bottom: 6px;">
                    <span style="font-size:0.85rem; color:var(--text-muted);">Đang chờ BCS duyệt hoàn:</span>
                    <strong style="color:var(--warning);" id="myPendingRefund">0.0000 ETH</strong>
                  </div>
                  <div style="display:flex; justify-content:space-between;">
                    <span style="font-size:0.85rem; color:var(--text-muted);">Hạn mức hoàn khả dụng:</span>
                    <strong style="color:var(--success);" id="myAvailableRefund">0.0000 ETH</strong>
                  </div>
                </div>

                <!-- Thông báo yêu cầu kết nối ví sinh viên -->
                <div id="noticeStudentNeedWallet" class="role-notice-banner"
                  style="display: none; background: var(--amber-light); border: 1px solid var(--amber-border); border-radius: var(--radius-md); padding: 18px; margin-bottom: 16px; text-align: center;">
                  <div style="font-size: 1.5rem; margin-bottom: 6px;">🔐</div>
                  <h4 style="color: var(--amber-accent); font-size: 1.05rem; margin-bottom: 6px;">Yêu cầu kết nối ví MetaMask</h4>
                  <p style="font-size: 0.88rem; color: var(--text-muted); margin-bottom: 12px;">
                    Để nộp tiền vào quỹ lớp hoặc gửi yêu cầu hoàn tiền, bạn cần kết nối ví MetaMask chứa tài khoản Sinh viên K57.
                  </p>
                  <button class="btn btn-warning" onclick="connectWallet()" style="display: inline-flex; align-items: center; gap: 8px; font-weight: 600;">
                    🦊 Kết nối ví MetaMask ngay
                  </button>
                </div>

                <!-- Thông báo tài khoản ngoài danh bạ -->
                <div id="noticeStudentGuest" class="role-notice-banner"
                  style="display: none; background: #fef2f2; border: 1px solid #fecaca; border-radius: var(--radius-md); padding: 16px; margin-bottom: 16px;">
                  <h4 style="color: #b91c1c; font-size: 1.05rem; margin-bottom: 6px; display: flex; align-items: center; gap: 8px;">
                    ⚠️ Ví chưa có trong danh bạ sinh viên K57
                  </h4>
                  <p style="font-size: 0.88rem; color: #475569; margin-bottom: 8px;">
                    Địa chỉ ví của bạn chưa được liên kết với hồ sơ sinh viên K57. Chức năng nộp quỹ và xin hoàn tiền chỉ áp dụng cho tài khoản đã được xác thực danh tính.
                  </p>
                  <p style="font-size: 0.82rem; color: #64748b; margin: 0;">
                    Vui lòng liên hệ Ban cán sự lớp hoặc Cố vấn học tập để cập nhật địa chỉ ví vào danh bạ lớp.
                  </p>
                </div>

                <!-- Thông báo cho Cố vấn học tập khi xem tab Sinh viên -->
                <div id="noticeStudentAdvisorView" class="role-notice-banner"
                  style="display: none; background: var(--advisor-bg); border: 1px solid var(--advisor-border); border-radius: var(--radius-md); padding: 14px 16px; margin-bottom: 16px;">
                  <span style="font-size: 0.88rem; color: var(--advisor-color);">
                    ℹ️ <strong>Chế độ giám sát Cố vấn học tập:</strong> Bạn đang theo dõi dữ liệu sinh viên ở chế độ đọc. Chức năng nộp quỹ và xin hoàn tiền chỉ dành cho sinh viên.
                  </span>
                </div>

                <!-- Form nộp quỹ -->
                <div id="sectionDepositForm"
                  style="background: #fff; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 18px;">
                  <h4 style="font-size: 1.05rem; margin-bottom: 8px; color: var(--primary-navy);">
                    1. Đóng góp tiền vào quỹ lớp
                  </h4>
                  <p style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 12px;">
                    Tự động tách 99% vào Quỹ lớp và 1% vào Quỹ phí vận hành.
                  </p>
                  <div class="form-group" style="margin-bottom: 10px;">
                    <label for="inputDepositAmount">Số ETH muốn đóng góp:</label>
                    <input type="number" step="0.001" min="0.001" class="form-control" id="inputDepositAmount"
                      placeholder="Ví dụ: 0.05">
                    <div class="form-helper-tip">💡 Gợi ý: 0.01 – 0.05 ETH. Quy tắc phân bổ: 99% vào Quỹ lớp chính, 1% vào Quỹ phí vận hành bù đắp gas.</div>
                  </div>
                  <button class="btn btn-success" id="btnDepositAction" style="width: 100%;">
                    Xác nhận nộp quỹ qua MetaMask
                  </button>
                </div>

                <!-- Form xin hoàn tiền -->
                <div id="sectionRefundForm"
                  style="background: #fff; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 18px;">
                  <h4 style="font-size: 1.05rem; margin-bottom: 8px; color: var(--primary-navy);">
                    2. Xin hoàn tiền khi nộp nhầm
                  </h4>
                  <p style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 12px;">
                    Nhận lại 99% số tiền xin hoàn sau khi được Ban cán sự phê duyệt (chịu 1% phí).
                  </p>
                  <div class="form-group" style="margin-bottom: 8px;">
                    <label for="inputRefundAmount">Số ETH xin hoàn lại:</label>
                    <input type="number" step="0.001" min="0.001" class="form-control" id="inputRefundAmount"
                      placeholder="Không vượt quá hạn mức khả dụng">
                    <div class="form-helper-tip">💡 Chỉ nộp đơn trong phạm vi hạn mức đóng góp khả dụng của bạn. Yêu cầu cần Ban cán sự bỏ phiếu ≥ 51%.</div>
                  </div>
                  <div class="form-group" style="margin-bottom: 12px;">
                    <label for="inputRefundReason">Lý do nộp nhầm:</label>
                    <input type="text" class="form-control" id="inputRefundReason"
                      placeholder="Ví dụ: Nộp thừa tiền quỹ kỳ 1">
                  </div>
                  <button class="btn btn-outline" id="btnCreateRefundAction" style="width: 100%;">
                    Gửi yêu cầu hoàn tiền đến Ban cán sự
                  </button>
                </div>

                <!-- Bảng danh sách yêu cầu hoàn tiền cá nhân -->
                <div>
                  <h4 style="font-size: 0.95rem; margin-bottom: 8px; color: var(--primary-navy);">
                    Yêu cầu hoàn tiền của bạn
                  </h4>
                  <div class="data-table-container">
                    <table class="data-table">
                      <thead>
                        <tr>
                          <th>Mã</th>
                          <th>Số ETH</th>
                          <th>Lý do</th>
                          <th>Tiến độ duyệt</th>
                          <th>Trạng thái</th>
                          <th>Thao tác</th>
                        </tr>
                      </thead>
                      <tbody id="studentRefundTableBody">
                        <tr>
                          <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 18px;">
                            Chưa có yêu cầu hoàn tiền nào từ tài khoản này.
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <!-- ======================================================== -->
            <!-- Ô 2: GIAO DIỆN BAN CÁN SỰ (BCS)                          -->
            <!-- ======================================================== -->
            <div class="role-panel panel-bcs" id="panelBCS" style="display: none;">
              <div class="panel-header" style="display: flex; justify-content: space-between; align-items: center;">
                <div class="panel-title"
                  style="color: var(--brand-blue); display: flex; align-items: center; gap: 8px;">
                  <svg style="width:24px;height:24px;fill:currentColor;" viewBox="0 0 24 24">
                    <path
                      d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" />
                  </svg>
                  <strong style="font-size: 1.25rem;">Ô Chi Tiết: Dành Cho Ban Cán Sự</strong>
                </div>
                <div style="display: flex; align-items: center; gap: 12px;">
                  <span class="panel-badge badge-bcs-role">Ban cán sự K57</span>
                  <button class="btn btn-sm btn-outline" style="padding: 4px 12px; font-size: 0.85rem;"
                    onclick="closeRoleDetail()">✕ Thu gọn</button>
                </div>
              </div>

              <div class="panel-body">
                <!-- Thông báo phân quyền Ban cán sự -->
                <div id="noticeBcsRestricted" class="role-notice-banner"
                  style="display: none; background: var(--bcs-bg); border: 1px solid var(--bcs-border); border-radius: var(--radius-md); padding: 16px; margin-bottom: 16px;">
                  <div id="noticeBcsRestrictedContent">
                    <!-- Dynamic role notice injected by syncRolePermissionsUI -->
                  </div>
                </div>

                <!-- Form tạo đề nghị chi -->
                <div id="sectionBcsCreateSpend"
                  style="background: #fff; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 18px;">
                  <h4 style="font-size: 1.05rem; margin-bottom: 8px; color: var(--primary-navy);">
                    1. Tạo đề nghị chi tiền mới
                  </h4>
                  <p style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 12px;">
                    Khoản chi cần được ít nhất 51% Ban cán sự bỏ phiếu đồng ý trong 7 ngày để giải ngân.
                  </p>
                  <div class="form-group" style="margin-bottom: 8px;">
                    <label for="inputSpendRecipient">Địa chỉ ví người nhận tiền:</label>
                    <input type="text" class="form-control" id="inputSpendRecipient" placeholder="0x...">
                    <div class="form-helper-tip">💡 Địa chỉ ví người thụ hưởng nhận giải ngân (42 ký tự, bắt đầu bằng 0x).</div>
                  </div>
                  <div class="form-group" style="margin-bottom: 8px;">
                    <label for="inputSpendAmount">Số ETH đề nghị chi:</label>
                    <input type="number" step="0.001" min="0.001" class="form-control" id="inputSpendAmount"
                      placeholder="Ví dụ: 0.1">
                    <div class="form-helper-tip">💡 Không được vượt quá số dư khả dụng của quỹ. Số tiền này sẽ được tạm giữ chỗ trên hợp đồng.</div>
                  </div>
                  <div class="form-group" style="margin-bottom: 12px;">
                    <label for="inputSpendDesc">Mục đích chi tiêu:</label>
                    <input type="text" class="form-control" id="inputSpendDesc"
                      placeholder="Ví dụ: Mua nước sự kiện giao lưu lớp">
                  </div>
                  <button class="btn btn-primary" id="btnCreateSpendAction" style="width: 100%;">
                    Tạo đề nghị chi & Tạm giữ ngân sách
                  </button>
                </div>

                <!-- Bảng đề nghị chi -->
                <div>
                  <h4 style="font-size: 0.95rem; margin-bottom: 8px; color: var(--primary-navy);">
                    2. Đề nghị chi cần biểu quyết / giải ngân
                  </h4>
                  <div class="data-table-container">
                    <table class="data-table">
                      <thead>
                        <tr>
                          <th>Mã</th>
                          <th>Người nhận</th>
                          <th>Số ETH</th>
                          <th>Nội dung</th>
                          <th>Tiến độ</th>
                          <th>Trạng thái</th>
                          <th>Bỏ phiếu</th>
                          <th>Giải ngân</th>
                        </tr>
                      </thead>
                      <tbody id="bcsSpendTableBody">
                        <tr>
                          <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 18px;">
                            Chưa có đề nghị chi tiền nào trong hợp đồng.
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>

                <!-- Bảng duyệt hoàn tiền -->
                <div>
                  <h4 style="font-size: 0.95rem; margin-bottom: 8px; color: var(--primary-navy);">
                    3. Đơn hoàn tiền từ sinh viên cần duyệt
                  </h4>
                  <div class="data-table-container">
                    <table class="data-table">
                      <thead>
                        <tr>
                          <th>Mã</th>
                          <th>Sinh viên</th>
                          <th>Số ETH</th>
                          <th>Lý do</th>
                          <th>Tiến độ</th>
                          <th>Trạng thái</th>
                          <th>Duyệt đơn</th>
                          <th>Hoàn tiền</th>
                        </tr>
                      </thead>
                      <tbody id="bcsRefundTableBody">
                        <tr>
                          <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 18px;">
                            Chưa có yêu cầu hoàn tiền nào từ sinh viên.
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>

            <!-- ======================================================== -->
            <!-- Ô 3: GIAO DIỆN CỐ VẤN HỌC TẬP (ADVISOR)                 -->
            <!-- ======================================================== -->
            <div class="role-panel panel-advisor" id="panelAdvisor" style="display: none;">
              <div class="panel-header" style="display: flex; justify-content: space-between; align-items: center;">
                <div class="panel-title"
                  style="color: var(--purple-role); display: flex; align-items: center; gap: 8px;">
                  <svg style="width:24px;height:24px;fill:currentColor;" viewBox="0 0 24 24">
                    <path
                      d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z" />
                  </svg>
                  <strong style="font-size: 1.25rem;">Ô Chi Tiết: Dành Cho Cố Vấn Học Tập</strong>
                </div>
                <div style="display: flex; align-items: center; gap: 12px;">
                  <span class="panel-badge badge-advisor-role">Cố vấn học tập</span>
                  <button class="btn btn-sm btn-outline" style="padding: 4px 12px; font-size: 0.85rem;"
                    onclick="closeRoleDetail()">✕ Thu gọn</button>
                </div>
              </div>

              <div class="panel-body">
                <!-- Thông báo phân quyền Cố vấn học tập -->
                <div id="noticeAdvisorRestricted" class="role-notice-banner"
                  style="display: none; background: var(--advisor-bg); border: 1px solid var(--advisor-border); border-radius: var(--radius-md); padding: 16px; margin-bottom: 16px;">
                  <div id="noticeAdvisorRestrictedContent">
                    <!-- Dynamic role notice injected by syncRolePermissionsUI -->
                  </div>
                </div>

                <!-- Quản trị nhân sự BCS -->
                <div id="sectionAdvisorManageBcs"
                  style="background: #fff; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 18px;">
                  <h4 style="font-size: 1.05rem; margin-bottom: 8px; color: var(--primary-navy);">
                    1. Quản lý nhân sự Ban cán sự
                  </h4>
                  <p style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 12px;">
                    Đặc quyền Cố vấn: Kích hoạt hoặc thu hồi quyền hạn thành viên Ban cán sự. Mẫu số biểu quyết 51% sẽ tự động cập nhật.
                  </p>
                  <div class="form-group" style="margin-bottom: 8px;">
                    <label for="inputBcsAddress">Địa chỉ ví thành viên:</label>
                    <input type="text" class="form-control" id="inputBcsAddress" placeholder="0x...">
                    <div class="form-helper-tip">💡 Ví thành viên sinh viên K57 được trao quyền tạo đề xuất và biểu quyết chi tiêu.</div>
                  </div>
                  <div class="form-group" style="margin-bottom: 12px;">
                    <label for="selectBcsStatus">Trạng thái phân quyền:</label>
                    <select class="form-control" id="selectBcsStatus">
                      <option value="true">Bổ nhiệm vào Ban cán sự (Kích hoạt quyền)</option>
                      <option value="false">Thu hồi quyền Ban cán sự (Tạm khóa)</option>
                    </select>
                  </div>
                  <button class="btn btn-purple" id="btnSetBcsAction" style="width: 100%;">
                    Cập nhật quyền Ban cán sự
                  </button>
                </div>

                <!-- Rút quỹ phí vận hành -->
                <div id="sectionAdvisorWithdrawFee"
                  style="background: #fff; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 18px;">
                  <h4 style="font-size: 1.05rem; margin-bottom: 8px; color: var(--primary-navy);">
                    2. Rút quỹ phí vận hành bù đắp gas
                  </h4>
                  <p style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 12px;">
                    Cố vấn được rút số dư từ Quỹ phí (1% trích từ tiền nạp) về ví để trang trải chi phí gas mạng lưới.
                  </p>
                  <div
                    style="background: #f8fafc; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 10px 14px; margin-bottom: 12px; display:flex; justify-content:space-between; align-items:center;">
                    <span style="font-size:0.85rem; color:var(--text-muted);">Số dư Quỹ phí hiện có:</span>
                    <strong style="color:var(--warning); font-size:1.1rem;" id="advisorFeePoolBalance">0.0000 ETH</strong>
                  </div>
                  <div class="form-group" style="margin-bottom: 12px;">
                    <label for="inputWithdrawFeeAmount">Số ETH muốn rút:</label>
                    <input type="number" step="0.001" min="0.001" class="form-control" id="inputWithdrawFeeAmount"
                      placeholder="Không vượt quá số dư quỹ phí">
                    <div class="form-helper-tip">💡 Rút từ Quỹ phí vận hành (adminFeePool) để bù đắp chi phí Gas mạng lưới cho quản trị viên.</div>
                  </div>
                  <button class="btn btn-success" id="btnWithdrawFeeAction" style="width: 100%;">
                    Rút quỹ phí về ví Cố vấn
                  </button>
                </div>
              </div>
            </div>

            <!-- ======================================================== -->
            <!-- Ô CHI TIẾT 4: TOÀN CẢNH FLOW DÒNG TIỀN & LỊCH SỬ THU CHI -->
            <!-- ======================================================== -->
            <div class="role-panel panel-history" id="panelHistory" style="display: none;">
              <div class="panel-header" style="display: flex; justify-content: space-between; align-items: center;">
                <div class="panel-title" style="color: #c2410c; display: flex; align-items: center; gap: 8px;">
                  <svg style="width:24px;height:24px;fill:currentColor;" viewBox="0 0 24 24">
                    <path
                      d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM7 10h2v7H7zm4-3h2v10h-2zm4 6h2v4h-2z" />
                  </svg>
                  <strong style="font-size: 1.25rem;">Ô Chi Tiết: Toàn Cảnh Flow Dòng Tiền & Lịch Sử Thu Chi</strong>
                </div>
                <div style="display: flex; align-items: center; gap: 12px;">
                  <span class="panel-badge" style="background:#ffedd5; color:#c2410c; border:1px solid #fed7aa;">Minh
                    bạch
                    On-chain</span>
                  <button class="btn btn-sm btn-outline" style="padding: 4px 12px; font-size: 0.85rem;"
                    onclick="closeRoleDetail()">✕ Thu gọn</button>
                </div>
              </div>

              <div class="panel-body">
                <!-- PHẦN 1: TÓM TẮT CÂN ĐỐI DÒNG TIỀN HIỆN TẠI -->
                <div class="flow-balance-grid">
                  <div class="flow-balance-card" style="border-left: 4px solid var(--success);">
                    <div class="flow-balance-title">Quỹ lớp khả dụng (99%)</div>
                    <div class="flow-balance-val" style="color:#047857;" id="flowBalClassFund">0.0000 ETH</div>
                    <div style="font-size:0.75rem; color:var(--text-muted); margin-top:2px;">Sẵn sàng phục vụ lớp</div>
                  </div>
                  <div class="flow-balance-card" style="border-left: 4px solid var(--warning);">
                    <div class="flow-balance-title">Tiền đang tạm giữ chờ duyệt</div>
                    <div class="flow-balance-val" style="color:#d97706;" id="flowBalReserved">0.0000 ETH</div>
                    <div style="font-size:0.75rem; color:var(--text-muted); margin-top:2px;">Khóa bảo đảm đề xuất
                      chi/hoàn
                    </div>
                  </div>
                  <div class="flow-balance-card" style="border-left: 4px solid var(--purple-role);">
                    <div class="flow-balance-title">Quỹ phí vận hành (1%)</div>
                    <div class="flow-balance-val" style="color:#6d28d9;" id="flowBalAdminFee">0.0000 ETH</div>
                    <div style="font-size:0.75rem; color:var(--text-muted); margin-top:2px;">Bù đắp gas cho Cố vấn</div>
                  </div>
                  <div class="flow-balance-card" style="border-left: 4px solid var(--brand-blue);">
                    <div class="flow-balance-title">Đã giải ngân chi tiêu</div>
                    <div class="flow-balance-val" style="color:#1d4ed8;" id="flowBalExecutedSpend">0.0000 ETH</div>
                    <div style="font-size:0.75rem; color:var(--text-muted); margin-top:2px;" id="flowBalExecutedCount">0
                      đề
                      xuất đã chuyển tiền</div>
                  </div>
                </div>

                <!-- PHẦN 2: SƠ ĐỒ TOÀN BỘ 4 FLOW CỦA DÒNG TIỀN -->
                <div
                  style="background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 20px; margin-bottom: 24px;">
                  <h4
                    style="font-size: 1.05rem; margin-bottom: 4px; color: var(--primary-navy); display: flex; align-items: center; gap: 8px;">
                    <span>🔄</span> Sơ Đồ Toàn Bộ Các Luồng (Flow) Của Dòng Tiền Quỹ Lớp
                  </h4>
                  <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px;">
                    Mỗi luồng tiền trong hệ thống đều tuân thủ các quy tắc kinh tế chuẩn mực và tự động ghi nhận trên
                    Smart
                    Contract:
                  </p>

                  <div class="flow-steps-grid">
                    <!-- Flow 1: Inflow -->
                    <div class="flow-step-box" style="border-top: 3px solid #10b981;">
                      <span class="flow-step-badge flow-badge-inflow">📥 FLOW 1: THU NẠP QUỸ</span>
                      <h5 style="font-size:0.92rem; margin-bottom:6px; color:#065f46;">Sinh viên đóng góp ETH</h5>
                      <p style="font-size:0.8rem; color:var(--text-muted); line-height:1.5;">
                        Sinh viên gửi ETH vào quỹ ➔ Hợp đồng tự động tách:
                        <br><strong>● 99%</strong> nạp vào Quỹ lớp chính.
                        <br><strong>● 1%</strong> nạp vào Quỹ phí vận hành.
                      </p>
                    </div>

                    <!-- Flow 2: Spend Flow -->
                    <div class="flow-step-box" style="border-top: 3px solid #2563eb;">
                      <span class="flow-step-badge flow-badge-spend">📤 FLOW 2: CHI TIÊU QUỸ</span>
                      <h5 style="font-size:0.92rem; margin-bottom:6px; color:#1e40af;">Đề xuất & Biểu quyết 51%</h5>
                      <p style="font-size:0.8rem; color:var(--text-muted); line-height:1.5;">
                        BCS tạo đề xuất ➔ Khóa tạm giữ tiền ➔ BCS biểu quyết (7 ngày).
                        <br>➔ <strong>&ge; 51% thuận:</strong> Giải ngân chuyển ETH đến ví nhận.
                        <br>➔ <strong>Từ chối / Hết hạn:</strong> Trả tiền về quỹ.
                      </p>
                    </div>

                    <!-- Flow 3: Refund Flow -->
                    <div class="flow-step-box" style="border-top: 3px solid #ea580c;">
                      <span class="flow-step-badge flow-badge-refund">🔄 FLOW 3: HOÀN TIỀN NHẦM</span>
                      <h5 style="font-size:0.92rem; margin-bottom:6px; color:#9a3412;">Sinh viên xin rút lại tiền</h5>
                      <p style="font-size:0.8rem; color:var(--text-muted); line-height:1.5;">
                        Sinh viên tạo yêu cầu ➔ Khóa hạn mức ➔ BCS biểu quyết (7 ngày).
                        <br>➔ <strong>&ge; 51% thuận:</strong> Hoàn <strong>99%</strong> về ví sinh viên,
                        <strong>1%</strong> đưa vào quỹ phí.
                      </p>
                    </div>

                    <!-- Flow 4: Gas Rebalance -->
                    <div class="flow-step-box" style="border-top: 3px solid #8b5cf6;">
                      <span class="flow-step-badge flow-badge-gas">⛽ FLOW 4: PHÍ BÙ ĐẮP GAS</span>
                      <h5 style="font-size:0.92rem; margin-bottom:6px; color:#6b21a8;">Bù chi phí mạng lưới</h5>
                      <p style="font-size:0.8rem; color:var(--text-muted); line-height:1.5;">
                        Trích từ Quỹ phí vận hành (1%) ➔ Cố vấn học tập rút về ví để bù đắp chi phí gas khi deploy và
                        quản
                        lý nhân sự Ban cán sự.
                      </p>
                    </div>
                  </div>
                </div>

                <!-- PHẦN 3: SỔ NHẬT KÝ & THEO DÕI TẤT CẢ CÁC KHOẢN CHI & HOÀN TIỀN CỦA LỚP -->
                <div>
                  <div
                    style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; margin-bottom:12px;">
                    <div>
                      <h4 style="font-size: 1.05rem; color: var(--primary-navy); margin-bottom:2px;">
                        📜 Sổ Nhật Ký Dòng Tiền & Tình Trạng Xét Duyệt Mọi Đề Xuất
                      </h4>
                      <p style="font-size: 0.82rem; color: var(--text-muted);">
                        Tất cả thành viên đều có thể theo dõi chi tiết từng khoản chi, lý do và tiến độ duyệt của Ban
                        cán
                        sự:
                      </p>
                    </div>

                    <!-- Bộ lọc dòng tiền -->
                    <div class="flow-filter-group" id="flowFilterGroup">
                      <span style="font-size: 0.8rem; color: var(--text-muted); font-weight: 600;">Lọc theo:</span>
                      <button class="flow-filter-btn active" onclick="filterFlowLedger('all', this)">Tất cả</button>
                      <button class="flow-filter-btn" onclick="filterFlowLedger('spend', this)">📤 Đề xuất chi</button>
                      <button class="flow-filter-btn" onclick="filterFlowLedger('refund', this)">🔄 Hoàn tiền</button>
                      <button class="flow-filter-btn" onclick="filterFlowLedger('executed', this)">🟢 Đã giải ngân /
                        Hoàn
                        tất</button>
                      <button class="flow-filter-btn" onclick="filterFlowLedger('pending', this)">🟡 Đang biểu
                        quyết</button>
                    </div>
                  </div>

                  <div class="data-table-container">
                    <table class="data-table">
                      <thead>
                        <tr>
                          <th>Loại Flow</th>
                          <th>Mã</th>
                          <th>Số ETH</th>
                          <th>Người liên quan</th>
                          <th>Nội dung / Lý do</th>
                          <th>Tiến độ biểu quyết</th>
                          <th>Tình trạng xét duyệt</th>
                          <th>Tra cứu</th>
                        </tr>
                      </thead>
                      <tbody id="flowLedgerTableBody">
                        <tr>
                          <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 24px;">
                            Chưa có dữ liệu dòng tiền on-chain. Vui lòng kết nối ví và cấu hình hợp đồng.
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>

                  <!-- Nút tra cứu Etherscan -->
                  <div
                    style="margin-top: 16px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; background: #f8fafc; padding: 12px 18px; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
                    <div style="font-size: 0.85rem; color: var(--text-muted);">
                      💡 Dữ liệu được ghi nhận vĩnh viễn và không thể sửa đổi trên sổ cái phân tán Ethereum Sepolia.
                    </div>
                    <a id="flowLinkEtherscan" href="https://sepolia.etherscan.io" target="_blank"
                      class="btn btn-sm btn-outline" style="font-size: 0.85rem;">
                      Tra cứu chi tiết trên Sepolia Etherscan &rarr;
                    </a>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </section>

      <!-- BỐI CẢNH, VẤN ĐỀ & MỤC TIÊU DỰ ÁN -->
      <section id="about">
        <div class="container">
          <div class="section-header">
            <span class="section-badge">Bối Cảnh & Vấn Đề</span>
            <h2 class="section-title">Tại sao chúng tôi xây dựng KTS-Class-Fund?</h2>
            <p class="section-desc">
              Những khó khăn thường gặp khi quản lý quỹ lớp bằng phương pháp thủ công và cách công nghệ Blockchain giúp
              giải
              quyết minh bạch.
            </p>
          </div>

          <div class="grid-3" style="margin-bottom: 28px;">
            <div class="card">
              <div class="card-icon">
                <svg viewBox="0 0 24 24">
                  <path fill="currentColor"
                    d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z" />
                </svg>
              </div>
              <h3 class="card-title">Thông tin thu chi nằm ở nhiều nơi</h3>
              <p class="card-desc">
                Tiền chuyển vào tài khoản cá nhân, thông báo nằm rải rác trên các nhóm mạng xã hội, bảng sao kê giấy dễ
                thất
                lạc khiến việc đối chiếu thông tin trở nên phức tạp.
              </p>
            </div>

            <div class="card">
              <div class="card-icon">
                <svg viewBox="0 0 24 24">
                  <path fill="currentColor"
                    d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" />
                </svg>
              </div>
              <h3 class="card-title">Khó theo dõi tiến trình đề xuất</h3>
              <p class="card-desc">
                Thành viên lớp khó nắm bắt một khoản chi do ai khởi xướng, đã được bao nhiêu người đồng ý, còn hạn biểu
                quyết hay không, dẫn đến băn khoăn về tính khách quan.
              </p>
            </div>

            <div class="card">
              <div class="card-icon">
                <svg viewBox="0 0 24 24">
                  <path fill="currentColor"
                    d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z" />
                </svg>
              </div>
              <h3 class="card-title">Người quản lý phải giải thích lặp lại</h3>
              <p class="card-desc">
                Ban cán sự thường xuyên phải tốn nhiều thời gian chụp màn hình, giải thích tiến độ thu chi cho từng
                thành
                viên thay vì có một hệ thống tự động cập nhật công khai.
              </p>
            </div>
          </div>

          <!-- 6 Goals -->
          <div class="section-header" style="margin-bottom: 16px;">
            <h3 style="font-size: 1.5rem;">6 Mục Tiêu Cốt Lõi Của Dự Án</h3>
          </div>
          <div class="grid-3">
            <div class="card">
              <h4 style="margin-bottom: 8px; color: var(--brand-blue);">1. Minh bạch hóa giao dịch</h4>
              <p class="card-desc">Giúp người dùng dễ dàng kiểm tra các khoản đóng góp, đề xuất chi và hoàn tiền đã được
                ghi
                nhận trực tiếp trên sổ cái blockchain.</p>
            </div>
            <div class="card">
              <h4 style="margin-bottom: 8px; color: var(--brand-blue);">2. Quy trình hóa rõ ràng</h4>
              <p class="card-desc">Mô tả rõ ràng từng bước từ lúc đóng góp đến khi đề xuất, biểu quyết tập thể, giải
                ngân
                hoặc dọn dẹp khoản tiền quá hạn.</p>
            </div>
            <div class="card">
              <h4 style="margin-bottom: 8px; color: var(--brand-blue);">3. Phân định quyền hạn chuẩn mực</h4>
              <p class="card-desc">Mỗi vai trò (Cố vấn học tập, Ban cán sự, Sinh viên) chỉ được thực hiện đúng các chức
                năng
                tương ứng mà hợp đồng cho phép.</p>
            </div>
            <div class="card">
              <h4 style="margin-bottom: 8px; color: var(--brand-blue);">4. Dễ tiếp cận cho sinh viên</h4>
              <p class="card-desc">Sử dụng ngôn ngữ tự nhiên, giao diện trực quan và hướng dẫn từng bước chi tiết, không
                đòi
                hỏi người dùng phải biết lập trình.</p>
            </div>
            <div class="card">
              <h4 style="margin-bottom: 8px; color: var(--brand-blue);">5. Có thể kiểm chứng độc lập</h4>
              <p class="card-desc">Cung cấp liên kết tra cứu trực tiếp trên trình khám phá khối Sepolia Etherscan và mã
                băm
                giao dịch cho mọi hoạt động.</p>
            </div>
            <div class="card">
              <h4 style="margin-bottom: 8px; color: var(--brand-blue);">6. Hỗ trợ giám sát tập thể</h4>
              <p class="card-desc">Giúp mọi thành viên cùng theo dõi trạng thái dòng tiền thực tế thay vì chỉ nhận thông
                báo
                bằng lời nói hoặc bảng tính riêng lẻ.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- QUY TRÌNH HOẠT ĐỘNG CHUẨN HÓA -->
      <section id="workflow" style="background: #f1f5f9;">
        <div class="container">
          <div class="section-header">
            <span class="section-badge">Quy Trình Hoạt Động</span>
            <h2 class="section-title">Hai Quy Trình Quản Lý Quỹ Lớp</h2>
            <p class="section-desc">
              Toàn bộ hoạt động thu chi và hoàn tiền được mô tả bằng ngôn ngữ tự nhiên, phản ánh chính xác quy tắc được
              lập
              trình trong hợp đồng.
            </p>
          </div>

          <!-- Quy trình 1: Đóng góp và Chi tiêu -->
          <div style="margin-bottom: 50px;">
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
              <div
                style="background: var(--brand-blue); color: #fff; padding: 6px 14px; border-radius: var(--radius-sm); font-weight: 700;">
                QUY TRÌNH 1</div>
              <h3 style="font-size: 1.35rem;">Đóng góp và Chi tiêu Quỹ lớp</h3>
            </div>

            <div class="timeline">
              <div class="timeline-step">
                <div class="step-badge">1</div>
                <div class="step-content">
                  <h4><span>Bước 1 — Sinh viên đóng góp vào quỹ</span> <span class="status-pill status-executed">Đã ghi
                      nhận</span></h4>
                  <div class="step-meta">
                    <span class="meta-tag">Ai thực hiện: <strong>Mọi sinh viên</strong></span>
                    <span class="meta-tag">Tỷ lệ: <strong>99% vào quỹ lớp, 1% vào quỹ phí</strong></span>
                  </div>
                  <p class="card-desc">
                    Mọi sinh viên đều có thể đóng góp ETH vào quỹ lớp bằng ví MetaMask. Theo quy định được triển khai
                    trong
                    hợp đồng, 99% số tiền đóng góp được đưa vào quỹ lớp và 1% được đưa vào quỹ phí. Sau khi giao dịch
                    được
                    xác nhận trên blockchain, khoản đóng góp được ghi nhận công khai.
                    <br><em>Ví dụ thực tế:</em> Đóng góp 1 ETH thì 0,99 ETH vào quỹ lớp và 0,01 ETH vào quỹ phí vận
                    hành.
                  </p>
                </div>
              </div>

              <div class="timeline-step">
                <div class="step-badge">2</div>
                <div class="step-content">
                  <h4><span>Bước 2 — Ban cán sự đề nghị chi tiền</span> <span class="status-pill status-pending">Đang
                      chờ
                      biểu quyết</span></h4>
                  <div class="step-meta">
                    <span class="meta-tag">Ai thực hiện: <strong>Thành viên Ban cán sự đang hoạt động</strong></span>
                    <span class="meta-tag">Yêu cầu: <strong>Số tiền, người nhận, lý do chi</strong></span>
                  </div>
                  <p class="card-desc">
                    Khi cần sử dụng quỹ cho một hoạt động của lớp, thành viên ban cán sự có quyền tạo đề nghị chi tiền.
                    Đề
                    nghị cần ghi rõ số tiền, người nhận và lý do chi. Hệ thống kiểm tra số dư khả dụng và tạm giữ khoản
                    tiền
                    tương ứng để tránh sử dụng cùng một khoản tiền cho nhiều đề nghị khác nhau.
                  </p>
                </div>
              </div>

              <div class="timeline-step">
                <div class="step-badge">3</div>
                <div class="step-content">
                  <h4><span>Bước 3 — Ban cán sự biểu quyết</span> <span class="status-pill status-pending">Đang bỏ
                      phiếu</span></h4>
                  <div class="step-meta">
                    <span class="meta-tag">Ai thực hiện: <strong>Các thành viên Ban cán sự đủ điều kiện</strong></span>
                    <span class="meta-tag">Quy định: <strong>Mỗi người 1 phiếu, thời hạn 7 ngày</strong></span>
                  </div>
                  <p class="card-desc">
                    Các thành viên ban cán sự đủ điều kiện tham gia sẽ xem nội dung đề nghị và chọn đồng ý hoặc không
                    đồng
                    ý. Mỗi thành viên chỉ được bỏ phiếu một lần cho mỗi đề nghị. Thời gian biểu quyết là 7 ngày theo quy
                    định của hợp đồng.
                  </p>
                </div>
              </div>

              <div class="timeline-step">
                <div class="step-badge">4</div>
                <div class="step-content">
                  <h4><span>Bước 4 — Hệ thống xác định kết quả</span> <span class="status-pill status-ready">Đã đủ điều
                      kiện
                      giải ngân</span></h4>
                  <div class="step-meta">
                    <span class="meta-tag">Ngưỡng thông qua: <strong>Tối thiểu 51% tổng số Ban cán sự</strong></span>
                    <span class="meta-tag">Lưu ý: <strong>Tiền chưa tự động chuyển</strong></span>
                  </div>
                  <p class="card-desc">
                    Sau mỗi lượt bỏ phiếu, hệ thống cập nhật kết quả. Khi số phiếu đồng ý đạt ngưỡng thông qua (ít nhất
                    51%
                    tổng số thành viên ban cán sự đang hoạt động), đề nghị được chuyển sang trạng thái <strong>"Đã đủ
                      điều
                      kiện giải ngân"</strong>. Nếu chưa đạt ngưỡng, đề nghị tiếp tục chờ biểu quyết cho đến khi hết
                    hạn.
                    <br><em>Quan trọng:</em> Đạt ngưỡng thông qua không đồng nghĩa với việc tiền đã được chuyển ngay lập
                    tức.
                  </p>
                </div>
              </div>

              <div class="timeline-step">
                <div class="step-badge">5</div>
                <div class="step-content">
                  <h4><span>Bước 5 — Thực hiện chi tiền</span> <span class="status-pill status-executed">Đã chi tiền
                      thành
                      công</span></h4>
                  <div class="step-meta">
                    <span class="meta-tag">Ai thực hiện: <strong>Thành viên Ban cán sự</strong></span>
                    <span class="meta-tag">Hành động: <strong>Kiểm tra điều kiện & chuyển tiền</strong></span>
                  </div>
                  <p class="card-desc">
                    Sau khi đề nghị đáp ứng đủ điều kiện, một thành viên ban cán sự được phép thực hiện giải ngân. Hệ
                    thống
                    kiểm tra điều kiện trước khi chuyển tiền đến người nhận. Chỉ khi giao dịch được thực hiện thành công
                    trên blockchain, đề nghị mới được ghi nhận là đã chi tiền hoàn tất.
                  </p>
                </div>
              </div>

              <div class="timeline-step">
                <div class="step-badge">6</div>
                <div class="step-content">
                  <h4><span>Bước 6 — Xử lý đề nghị hết hạn</span> <span class="status-pill status-expired">Đã hết
                      hạn</span>
                  </h4>
                  <div class="step-meta">
                    <span class="meta-tag">Ai thực hiện: <strong>Bất kỳ ai (sau 7 ngày)</strong></span>
                    <span class="meta-tag">Kết quả: <strong>Giải phóng khoản tiền đã tạm giữ</strong></span>
                  </div>
                  <p class="card-desc">
                    Nếu hết thời gian biểu quyết (7 ngày) mà đề nghị không đạt điều kiện thông qua, bất kỳ ai cũng có
                    thể
                    yêu cầu hệ thống kết thúc đề nghị quá hạn. Khoản tiền đã tạm giữ được giải phóng để có thể sử dụng
                    cho
                    các mục đích chi tiêu khác của lớp.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Quy trình 2: Hoàn tiền khi nộp nhầm -->
          <div>
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
              <div
                style="background: var(--brand-cyan); color: #fff; padding: 6px 14px; border-radius: var(--radius-sm); font-weight: 700;">
                QUY TRÌNH 2</div>
              <h3 style="font-size: 1.35rem;">Hoàn tiền khi sinh viên nộp nhầm</h3>
            </div>

            <div class="timeline">
              <div class="timeline-step">
                <div class="step-badge">1</div>
                <div class="step-content">
                  <h4><span>Bước 1 — Sinh viên gửi yêu cầu hoàn tiền</span> <span class="status-pill status-pending">Đã
                      gửi
                      yêu cầu</span></h4>
                  <div class="step-meta">
                    <span class="meta-tag">Ai thực hiện: <strong>Sinh viên đã đóng góp vào quỹ</strong></span>
                    <span class="meta-tag">Điều kiện: <strong>Không vượt quá số tiền đã đóng góp</strong></span>
                  </div>
                  <p class="card-desc">
                    Khi sinh viên phát hiện đã chuyển nhầm tiền vào quỹ lớp, sinh viên có thể tạo yêu cầu hoàn tiền trực
                    tiếp trên website. Hệ thống sẽ kiểm tra để đảm bảo số tiền yêu cầu hoàn không vượt quá số tiền mà
                    chính
                    sinh viên đó đã thực sự đóng góp vào quỹ.
                  </p>
                </div>
              </div>

              <div class="timeline-step">
                <div class="step-badge">2</div>
                <div class="step-content">
                  <h4><span>Bước 2 — Hệ thống tạm giữ khoản tiền</span> <span class="status-pill status-pending">Đang
                      tạm
                      giữ</span></h4>
                  <div class="step-meta">
                    <span class="meta-tag">Cơ chế: <strong>Bảo vệ dòng tiền hai chiều</strong></span>
                    <span class="meta-tag">Mục đích: <strong>Tránh rút tiền trùng lặp</strong></span>
                  </div>
                  <p class="card-desc">
                    Khoản tiền xin hoàn được hệ thống tạm giữ từ số dư quỹ lớp, đồng thời tạm khóa khỏi hạn mức của sinh
                    viên để đảm bảo an toàn, tránh việc cùng một khoản tiền bị sử dụng hoặc xin hoàn nhiều lần.
                  </p>
                </div>
              </div>

              <div class="timeline-step">
                <div class="step-badge">3</div>
                <div class="step-content">
                  <h4><span>Bước 3 — Ban cán sự xem xét và biểu quyết</span> <span
                      class="status-pill status-pending">Đang
                      duyệt</span></h4>
                  <div class="step-meta">
                    <span class="meta-tag">Ai thực hiện: <strong>Thành viên Ban cán sự</strong></span>
                    <span class="meta-tag">Thời hạn: <strong>7 ngày biểu quyết</strong></span>
                  </div>
                  <p class="card-desc">
                    Các thành viên ban cán sự kiểm tra lý do và thông tin nộp nhầm của sinh viên. Ban cán sự tham gia bỏ
                    phiếu đồng ý hoặc không đồng ý để đảm bảo quỹ lớp không bị rút tùy tiện.
                  </p>
                </div>
              </div>

              <div class="timeline-step">
                <div class="step-badge">4</div>
                <div class="step-content">
                  <h4><span>Bước 4 — Xác định kết quả và hoàn trả</span> <span class="status-pill status-ready">Đã thông
                      qua</span></h4>
                  <div class="step-meta">
                    <span class="meta-tag">Ngưỡng duyệt: <strong>Tối thiểu 51% Ban cán sự</strong></span>
                    <span class="meta-tag">Mức hoàn: <strong>Nhận lại 99%, chịu 1% phí</strong></span>
                  </div>
                  <p class="card-desc">
                    Khi đạt đủ từ 51% số phiếu đồng ý của ban cán sự, yêu cầu chuyển sang trạng thái sẵn sàng hoàn tiền.
                    Sinh viên hoặc ban cán sự có thể bấm thực hiện hoàn tiền. Theo quy định, sinh viên nhận lại 99% số
                    tiền
                    đã yêu cầu và chịu 1% phí vận hành (để bù đắp phí giao dịch trên blockchain).
                    <br><em>Ví dụ thực tế:</em> Nếu xin hoàn lại 0,1 ETH thì sinh viên nhận về ví 0,099 ETH, còn 0,001
                    ETH
                    được giữ lại trong quỹ phí.
                  </p>
                </div>
              </div>

              <div class="timeline-step">
                <div class="step-badge">5</div>
                <div class="step-content">
                  <h4><span>Bước 5 — Xử lý khi yêu cầu hết hạn</span> <span class="status-pill status-expired">Đã hết
                      hạn</span></h4>
                  <div class="step-meta">
                    <span class="meta-tag">Thời gian: <strong>Sau 7 ngày không đủ phiếu</strong></span>
                    <span class="meta-tag">Kết quả: <strong>Giải phóng khoản tiền đã tạm giữ</strong></span>
                  </div>
                  <p class="card-desc">
                    Nếu quá 7 ngày mà yêu cầu không nhận đủ số phiếu đồng thuận từ ban cán sự, yêu cầu sẽ hết hạn. Toàn
                    bộ
                    số tiền tạm giữ sẽ được giải phóng và hoàn trả lại hạn mức cho sinh viên và quỹ lớp.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- QUY CHẾ BIỂU QUYẾT 51% -->
      <section id="governance">
        <div class="container">
          <div class="section-header">
            <span class="section-badge">Quy Chế Biểu Quyết</span>
            <h2 class="section-title">Khi Nào Một Đề Xuất Được Thông Qua?</h2>
            <p class="section-desc">
              Bảng giải đáp rõ ràng các quy tắc biểu quyết, tỷ lệ thông qua và vòng đời của một đề nghị chi tiêu trong
              lớp.
            </p>
          </div>

          <div class="grid-2">
            <div class="card">
              <h4 style="color: var(--brand-blue); margin-bottom: 6px;">1. Ai có quyền tạo đề nghị chi tiền?</h4>
              <p class="card-desc">Chỉ những thành viên Ban cán sự lớp đang hoạt động hợp lệ mới có quyền tạo đề nghị
                chi
                tiền. Sinh viên không có quyền này.</p>
            </div>

            <div class="card">
              <h4 style="color: var(--brand-blue); margin-bottom: 6px;">2. Ai có quyền tham gia biểu quyết?</h4>
              <p class="card-desc">Chỉ các thành viên Ban cán sự đang hoạt động mới được bỏ phiếu. Mỗi thành viên có
                quyền
                biểu quyết độc lập và công bằng.</p>
            </div>

            <div class="card">
              <h4 style="color: var(--brand-blue); margin-bottom: 6px;">3. Mỗi thành viên được bỏ phiếu bao nhiêu lần?
              </h4>
              <p class="card-desc">Chính xác 01 lần duy nhất cho mỗi đề nghị. Hệ thống ghi nhận địa chỉ ví đã bỏ phiếu
                để
                tránh việc một người bỏ phiếu nhiều lần.</p>
            </div>

            <div class="card">
              <h4 style="color: var(--brand-blue); margin-bottom: 6px;">4. Ngưỡng thông qua chính xác là bao nhiêu?</h4>
              <p class="card-desc">Tối thiểu <strong>51%</strong> số phiếu đồng ý tính trên <strong>tổng số thành viên
                  Ban
                  cán sự đang hoạt động</strong>. Ví dụ: Nếu lớp có 3 thành viên Ban cán sự thì cần ít nhất 2 phiếu đồng
                ý
                (2/3 = 66,7% &ge; 51%).</p>
            </div>

            <div class="card">
              <h4 style="color: var(--brand-blue); margin-bottom: 6px;">5. Thời hạn biểu quyết bắt đầu và kết thúc khi
                nào?
              </h4>
              <p class="card-desc">Thời hạn là đúng <strong>7 ngày</strong> tính từ thời điểm đề nghị chi tiền được tạo
                thành công. Sau 7 ngày, cổng bỏ phiếu tự động đóng lại.</p>
            </div>

            <div class="card">
              <h4 style="color: var(--brand-blue); margin-bottom: 6px;">6. Đạt ngưỡng có tự động chuyển tiền ngay không?
              </h4>
              <p class="card-desc"><strong>Không tự động chuyển tiền.</strong> Đạt ngưỡng chỉ giúp đề nghị chuyển sang
                trạng
                thái "Đã đủ điều kiện giải ngân". Cần một thành viên Ban cán sự bấm nút thực hiện giải ngân trên hệ
                thống.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- PHÂN BỔ TÀI CHÍNH 99% / 1% -->
      <section id="economics" style="background: #f1f5f9;">
        <div class="container">
          <div class="section-header">
            <span class="section-badge">Quy Tắc Tài Chính</span>
            <h2 class="section-title">Quy Tắc Phân Bổ 99% / 1% & Cơ Chế Phí Gas</h2>
            <p class="section-desc">
              Công thức phân bổ minh bạch cho từng khoản đóng góp và giải thích dễ hiểu về chi phí giao dịch trên
              blockchain.
            </p>
          </div>

          <div class="grid-2" style="align-items: center;">
            <div>
              <h3 style="margin-bottom: 16px; font-size: 1.4rem;">Cách quỹ phân bổ dòng tiền tự động</h3>
              <p class="card-desc" style="margin-bottom: 16px;">
                Khi sinh viên đóng góp ETH vào quỹ lớp, hệ thống sẽ tự động tách số tiền thành hai phần riêng biệt:
              </p>
              <ul
                style="padding-left: 20px; color: var(--text-muted); font-size: 0.95rem; line-height: 1.8; margin-bottom: 24px;">
                <li><strong>99% đưa vào Quỹ lớp:</strong> Phục vụ các hoạt động học tập, phong trào, sự kiện chung của
                  tập
                  thể lớp K57.</li>
                <li><strong>1% đưa vào Quỹ phí vận hành:</strong> Dành riêng cho Cố vấn học tập rút về để bù đắp chi phí
                  Gas
                  mạng lưới blockchain khi thực hiện các giao dịch quản trị.</li>
                <li><strong>Quy định khi hoàn tiền nộp nhầm:</strong> Sinh viên xin hoàn tiền sẽ chịu 1% phí vận hành và
                  nhận lại 99% số tiền đã yêu cầu. Phần phí 1% không được hoàn lại để đảm bảo bù đắp chi phí vận hành hệ
                  thống.</li>
              </ul>

              <div
                style="background: var(--info-bg); border-left: 4px solid var(--brand-blue); padding: 14px; border-radius: var(--radius-sm);">
                <strong style="color: var(--brand-blue);">Giải thích về Phí Gas:</strong>
                <p style="font-size: 0.88rem; color: var(--text-muted); margin-top: 4px;">
                  Gas là khoản phí trả cho các máy tính trong mạng lưới blockchain để xử lý và ghi nhận giao dịch của
                  bạn.
                  Dù giao dịch thành công hay thất bại, máy tính vẫn phải tiêu tốn tài nguyên để kiểm tra, do đó phí gas
                  vẫn
                  bị trừ khỏi ví của bạn.
                </p>
              </div>
            </div>

            <!-- Simulator Box -->
            <div class="calc-box">
              <h4 style="font-size: 1.15rem; margin-bottom: 14px; color: var(--primary-navy);">
                Máy tính mô phỏng phân bổ dòng tiền
              </h4>
              <div class="form-group">
                <label for="calcInputEth">Số ETH đóng góp thử nghiệm:</label>
                <input type="number" step="0.01" min="0.01" value="1.0" class="form-control" id="calcInputEth">
              </div>

              <div
                style="background: #f8fafc; border-radius: var(--radius-md); padding: 14px; border: 1px solid var(--border-color);">
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                  <span style="font-size: 0.9rem; color: var(--text-muted);">Đưa vào Quỹ lớp (99%):</span>
                  <strong style="color: var(--brand-blue); font-size: 1.05rem;" id="calcClassFund">0.9900 ETH</strong>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                  <span style="font-size: 0.9rem; color: var(--text-muted);">Đưa vào Quỹ phí vận hành (1%):</span>
                  <strong style="color: var(--warning); font-size: 1.05rem;" id="calcAdminFee">0.0100 ETH</strong>
                </div>
                <div
                  style="border-top: 1px dashed var(--border-color); padding-top: 8px; display: flex; justify-content: space-between;">
                  <span style="font-size: 0.9rem; color: var(--text-muted);">Số tiền nhận lại nếu xin hoàn (99%):</span>
                  <strong style="color: var(--success); font-size: 1.05rem;" id="calcMaxRefund">0.9900 ETH</strong>
                </div>
              </div>
              <div style="font-size: 0.78rem; color: var(--text-light); margin-top: 10px; text-align: center;">
                * Đây là công cụ tính toán mô phỏng trực quan, không tạo giao dịch thật.
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- CẨM NANG BLOCKCHAIN 101 CHO SINH VIÊN -->
      <section id="blockchain">
        <div class="container">
          <div class="section-header">
            <span class="section-badge">Cẩm Nang 101</span>
            <h2 class="section-title">Blockchain & Hợp Đồng Thông Minh Là Gì?</h2>
            <p class="section-desc">
              Những khái niệm cơ bản nhất giúp sinh viên chưa từng học blockchain cũng có thể hiểu và tự tin sử dụng hệ
              thống.
            </p>
          </div>

          <div class="grid-3">
            <div class="card">
              <h4 style="color: var(--brand-blue); margin-bottom: 8px;">Blockchain là gì?</h4>
              <p class="card-desc">Là một cuốn sổ kế toán điện tử được chia sẻ đồng thời cho hàng ngàn máy tính. Một khi
                giao dịch đã được ghi lại, không ai có thể tự ý sửa xóa.</p>
            </div>
            <div class="card">
              <h4 style="color: var(--brand-blue); margin-bottom: 8px;">Smart Contract là gì?</h4>
              <p class="card-desc">Là chương trình máy tính tự động thực thi các điều khoản đã được thỏa thuận trước (ví
                dụ:
                đúng 51% người đồng ý thì mới cho phép chi tiền).</p>
            </div>
            <div class="card">
              <h4 style="color: var(--brand-blue); margin-bottom: 8px;">MetaMask là gì?</h4>
              <p class="card-desc">Là một tiện ích ví điện tử trên trình duyệt giúp bạn quản lý tài khoản, lưu giữ ETH
                và
                xác nhận các giao dịch một cách an toàn.</p>
            </div>
            <div class="card">
              <h4 style="color: var(--brand-blue); margin-bottom: 8px;">Địa chỉ ví & Địa chỉ hợp đồng?</h4>
              <p class="card-desc">Địa chỉ ví là tài khoản của bạn (bắt đầu bằng 0x...). Địa chỉ hợp đồng là "ngôi nhà"
                của
                quỹ lớp trên blockchain nơi tiền được lưu giữ và quản lý.</p>
            </div>
            <div class="card">
              <h4 style="color: var(--brand-blue); margin-bottom: 8px;">Mã giao dịch (Tx Hash) là gì?</h4>
              <p class="card-desc">Là mã biên lai duy nhất cho mỗi giao dịch. Bạn có thể dùng mã này để tra cứu chi tiết
                giờ
                giấc, số tiền và trạng thái giao dịch trên mạng.</p>
            </div>
            <div class="card">
              <h4 style="color: var(--brand-blue); margin-bottom: 8px;">Mạng Sepolia là gì?</h4>
              <p class="card-desc">Là mạng thử nghiệm chính thức của Ethereum. ETH trên Sepolia hoàn toàn miễn phí và
                không
                có giá trị quy đổi tiền mặt, giúp sinh viên thực hành an toàn.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- CÂU HỎI THƯỜNG GẶP (FAQ ACCORDION) -->
      <section id="faq" style="background: #f1f5f9;">
        <div class="container">
          <div class="section-header">
            <span class="section-badge">Giải Đáp Thắc Mắc</span>
            <h2 class="section-title">Câu Hỏi Thường Gặp (FAQ)</h2>
            <p class="section-desc">
              Tìm câu trả lời nhanh chóng cho các thắc mắc thường gặp về kết nối ví, đóng góp, biểu quyết và hoàn tiền.
            </p>
          </div>

          <div class="faq-search-box">
            <svg class="faq-search-icon" style="width:20px;height:20px;fill:currentColor;" viewBox="0 0 24 24">
              <path
                d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
            </svg>
            <input type="text" class="faq-search-input" id="faqSearchInput"
              placeholder="Nhập từ khóa tìm kiếm (ví dụ: hoàn tiền, gas, 51%, ví...)">
          </div>

          <div class="faq-controls-bar" style="max-width: 860px; margin: 0 auto 16px auto; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
            <div class="faq-category-pills" id="faqCategoryPills">
              <button type="button" class="faq-cat-btn active" onclick="setFaqCategory('all')">Tất cả (25)</button>
              <button type="button" class="faq-cat-btn" onclick="setFaqCategory('Tổng quan')">Tổng quan (5)</button>
              <button type="button" class="faq-cat-btn" onclick="setFaqCategory('Ví và kết nối')">Ví & Mạng (5)</button>
              <button type="button" class="faq-cat-btn" onclick="setFaqCategory('Đóng góp và phí')">Nộp quỹ & Phí (6)</button>
              <button type="button" class="faq-cat-btn" onclick="setFaqCategory('Đề xuất và biểu quyết')">Biểu quyết 51% (6)</button>
              <button type="button" class="faq-cat-btn" onclick="setFaqCategory('Hoàn tiền và lỗi giao dịch')">Hoàn tiền (3)</button>
            </div>
            <div class="faq-action-btns" style="display: flex; gap: 8px;">
              <button type="button" class="btn btn-sm btn-outline" id="btnToggleAllFaq" onclick="toggleAllFaq()">Mở rộng tất cả ▾</button>
            </div>
          </div>

          <div id="faqAccordionContainer" style="max-width: 860px; margin: 0 auto;"></div>

          <div id="faqShowMoreWrapper" style="text-align: center; margin-top: 18px; max-width: 860px; margin-left: auto; margin-right: auto;">
            <button type="button" class="btn btn-outline" id="btnToggleFaqLength" onclick="toggleFaqLength()" style="padding: 9px 24px; font-weight: 600; border-radius: 20px; box-shadow: var(--shadow-xs);">
              <span>Xem thêm câu hỏi khác ▾</span>
            </button>
          </div>
        </div>
      </section>

      <!-- MINH BẠCH VÀ CẤU HÌNH HỢP ĐỒNG -->
      <section id="transparency" style="background: #f8fafc; border-top: 1px solid var(--border-color);">
        <div class="container">
          <div class="section-header">
            <span class="section-badge">Minh Bạch Dữ Liệu</span>
            <h2 class="section-title">Cấu Hình Hợp Đồng & Nhật Ký On-chain</h2>
            <p class="section-desc">
              Thông tin chi tiết về hợp đồng trên mạng thử nghiệm Ethereum Sepolia và nhật ký tương tác thời gian thực.
            </p>
          </div>

          <div class="grid-2" style="margin-bottom: 30px;">
            <div class="card" style="background:#fff;">
              <h3 style="font-size: 1.2rem; margin-bottom: 16px;">Địa chỉ Hợp đồng Thông minh (Smart Contract)</h3>
              <div class="form-group">
                <label for="configContractAddress">Địa chỉ Hợp đồng (ProjectCore Address):</label>
                <input type="text" class="form-control" id="configContractAddress" value=""
                  placeholder="Dán địa chỉ sau khi deploy bằng Remix IDE tại đây">
              </div>
              <div style="display: flex; gap: 10px; margin-bottom: 16px; flex-wrap: wrap;">
                <button class="btn btn-primary btn-sm" id="btnApplyContractAddress">Áp dụng & Tải dữ liệu</button>
                <button class="btn btn-outline btn-sm" id="btnResetConfigContract" onclick="resetToDefaultContract()">🔄
                  Khôi phục mặc định</button>
                <a href="https://sepolia.etherscan.io" target="_blank" id="linkEtherscanContract"
                  class="btn btn-outline btn-sm">Xem trên Sepolia Etherscan &rarr;</a>
              </div>
              <div style="font-size: 0.85rem; color: var(--text-muted); line-height: 1.6;">
                
                <strong>Trạng thái:</strong> <span id="textContractConfigStatus"
                  style="color: var(--warning); font-weight: 600;">Chưa cấu hình địa chỉ hợp đồng</span><br>
                <strong>Ghi chú:</strong> Hệ thống tự động lưu địa chỉ hợp đồng vào trình duyệt của bạn sau khi bấm Áp
                dụng.
              </div>
            </div>

            <div class="card" style="background:#fff;">
              <h3
                style="font-size: 1.2rem; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center;">
                <span>Nhật ký giao dịch (Terminal)</span>
                <button class="btn btn-outline btn-sm" onclick="clearTerminal()">Xóa nhật ký</button>
              </h3>
              <div class="log-terminal" id="terminalLog">
                [Hệ thống] Đang tải cổng thông tin KTS Class Fund...
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <h3>KTS CLASS FUND</h3>
            <p style="line-height: 1.7; max-width: 420px;">
              Hệ thống quản lý quỹ lớp ứng dụng công nghệ Hợp đồng thông minh và Blockchain cho sinh viên lớp K57 ngành
              Kinh tế Số. Dự án phục vụ học phần ECO2432.
