  <!-- MODAL QUẢN TRỊ THÔNG BÁO LỚP (BCS & CỐ VẤN)                 -->
  <!-- ============================================================ -->
  <div class="modal-overlay" id="announcementModal">
    <div class="modal-box" style="max-width: 560px;">
      <div class="modal-header">
        <h3 style="margin: 0; color: #0f172a;">📢 Cập nhật thông báo Quỹ lớp K57</h3>
        <button class="modal-close" onclick="closeAnnModal()">&times;</button>
      </div>
      <div style="font-size: 0.92rem; line-height: 1.6; color: var(--text-main); margin-top: 10px;">
        <p style="color: #64748b; margin-bottom: 16px;">
          Quyền hạn: Dành riêng cho <strong>Cố vấn học tập</strong> và <strong>Ban cán sự</strong> để thông báo lịch thu
          quỹ và tiến độ cho cả lớp.
        </p>

        <div class="form-group" style="margin-bottom: 12px;">
          <label style="font-weight: 600; display: block; margin-bottom: 4px;">Tiêu đề đợt thu quỹ:</label>
          <input type="text" class="form-control" id="formAnnTitle" style="width: 100%;"
            placeholder="Ví dụ: Đợt thu Quỹ Lớp Học kỳ 1 - K57">
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
          <div class="form-group">
            <label style="font-weight: 600; display: block; margin-bottom: 4px;">Mức đóng (ETH/bạn):</label>
            <input type="number" step="0.001" min="0.001" class="form-control" id="formAnnAmount" style="width: 100%;"
              placeholder="0.01">
          </div>
          <div class="form-group">
            <label style="font-weight: 600; display: block; margin-bottom: 4px;">Sĩ số lớp (Tự động từ Danh bạ
              lớp):</label>
            <input type="number" min="1" class="form-control" id="formAnnClassSize"
              style="width: 100%; background: #f8fafc; cursor: not-allowed;" readonly
              title="Sĩ số lớp tự động tính theo số lượng sinh viên trong Danh bạ lớp K57" placeholder="5">
            <small class="text-muted" style="font-size: 0.75rem; color: #64748b; margin-top: 2px; display: block;">Tự
              động đồng bộ theo số người trong danh sách lớp.</small>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
          <div class="form-group">
            <label style="font-weight: 600; display: block; margin-bottom: 4px;">Hạn chót nộp:</label>
            <input type="text" class="form-control" id="formAnnDeadline" style="width: 100%;"
              placeholder="Ví dụ: 23:59 ngày 15/11/2026">
          </div>
          <div class="form-group">
            <label style="font-weight: 600; display: block; margin-bottom: 4px;">Trạng thái đợt thu:</label>
            <select class="form-control" id="formAnnStatus" style="width: 100%;">
              <option value="Đang diễn ra">🔴 Đang diễn ra</option>
              <option value="Sắp kết thúc">⏳ Sắp kết thúc</option>
              <option value="Đã hoàn thành">✅ Đã hoàn thành</option>
            </select>
          </div>
        </div>

        <div class="form-group" style="margin-bottom: 16px;">
          <label style="font-weight: 600; display: block; margin-bottom: 4px;">Mục đích chi tiết:</label>
          <textarea class="form-control" id="formAnnPurpose" rows="3" style="width: 100%;"
            placeholder="Nêu rõ mục đích thu quỹ (tài liệu học tập, các hoạt động ngoại khóa, teambuilding...)"></textarea>
        </div>
      </div>
      <div style="margin-top: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
        <button class="btn btn-danger btn-sm" id="btnCloseAnnouncementEarly" type="button" style="display: none;">
          🛑 Kết thúc đợt thu này (Chuyển sang Lịch sử)
        </button>
        <div style="display: flex; gap: 10px; margin-left: auto;">
          <button class="btn btn-secondary btn-sm" onclick="closeAnnModal()">Hủy bỏ</button>
          <button class="btn btn-primary btn-sm" id="btnSaveAnnouncementModal">Lưu & Đăng thông báo</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================================================ -->
  <!-- MODAL DANH BẠ SINH VIÊN K57 & XÁC THỰC VÍ                    -->
  <!-- ============================================================ -->
  <div class="modal-overlay" id="rosterModal" onclick="if(event.target === this) closeRosterModal()">
    <div class="modal-box">
      <!-- HEADER -->
      <div class="roster-modal-header"
        style="display: flex; align-items: flex-start; justify-content: space-between; border-bottom: 1px solid #e2e8f0; padding-bottom: 14px; margin-bottom: 14px;">
        <div>
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 4px; flex-wrap: wrap;">
            <h3
              style="margin: 0; color: #0f172a; font-size: 1.25rem; font-weight: 700; display: flex; align-items: center; gap: 8px;">
              <span>📋</span> Danh bạ Sinh viên &amp; Xác thực Ví Lớp K57
            </h3>
            <span class="roster-header-badge">ECO2432 &bull; K57 KTS</span>
          </div>
          <p style="margin: 0; color: #64748b; font-size: 0.85rem;">
            Hệ thống đối chiếu định danh minh bạch giữa Danh bạ lớp và Địa chỉ ví Web3 trên mạng Ethereum Sepolia.
          </p>
        </div>
        <button class="btn btn-sm btn-outline" id="btnCloseRosterHeader" onclick="closeRosterModal()"
          style="border: 1px solid #cbd5e1; cursor: pointer; padding: 6px 14px; border-radius: 8px; font-weight: 600; color: #475569; background: #fff; display: inline-flex; align-items: center; gap: 6px;"
          title="Đóng danh bạ (Phím Esc)">
          ✕ Đóng
        </button>
      </div>

      <!-- SCROLLABLE BODY -->
      <div class="roster-modal-body" style="overflow-y: auto; flex: 1; padding-right: 4px;">
        <!-- STATS CARDS -->
        <div class="roster-stats-grid">
          <div class="roster-stat-card">
            <div class="roster-stat-icon" style="background: #e0f2fe; color: #0284c7;">👥</div>
            <div>
              <div class="roster-stat-value" id="rosterStatTotal">0</div>
              <div class="roster-stat-label">Tổng sĩ số K57</div>
            </div>
          </div>
          <div class="roster-stat-card">
            <div class="roster-stat-icon" style="background: #fef3c7; color: #d97706;">⭐</div>
            <div>
              <div class="roster-stat-value" id="rosterStatBcs">0</div>
              <div class="roster-stat-label">Ban cán sự</div>
            </div>
          </div>
          <div class="roster-stat-card">
            <div class="roster-stat-icon" style="background: #dcfce7; color: #16a34a;">🎓</div>
            <div>
              <div class="roster-stat-value" id="rosterStatStudents">0</div>
              <div class="roster-stat-label">Sinh viên lớp</div>
            </div>
          </div>
          <div class="roster-stat-card">
            <div class="roster-stat-icon" style="background: #f3e8ff; color: #7e22ce;">💰</div>
            <div>
              <div class="roster-stat-value" id="rosterStatPaid">0/0</div>
              <div class="roster-stat-label">Tiến độ nộp quỹ</div>
            </div>
          </div>
        </div>

        <!-- SEARCH & FILTER TOOLBAR -->
        <div class="roster-toolbar">
          <div class="roster-search-wrapper">
            <span class="roster-search-icon">🔍</span>
            <input type="text" class="roster-search-input" id="rosterSearchInput"
              placeholder="Tìm theo Họ tên, MSSV hoặc Địa chỉ ví Ethereum (0x...)..." oninput="filterRosterTable()">
          </div>
          <div class="roster-filter-pills">
            <button class="roster-filter-btn active" id="rfFilterAll" onclick="setRosterFilter('all')">Tất cả</button>
            <button class="roster-filter-btn" id="rfFilterBcs" onclick="setRosterFilter('bcs')">⭐ Ban cán sự</button>
            <button class="roster-filter-btn" id="rfFilterStudent" onclick="setRosterFilter('student')">🎓 Sinh
              viên</button>
            <button class="roster-filter-btn" id="rfFilterPaid" onclick="setRosterFilter('paid')">✅ Đã nộp</button>
            <button class="roster-filter-btn" id="rfFilterUnpaid" onclick="setRosterFilter('unpaid')">⏳ Chưa
              nộp</button>
          </div>
        </div>

        <!-- TABLE WRAPPER -->
        <div class="roster-table-wrapper">
          <table class="roster-table">
            <thead>
              <tr>
                <th style="width: 50px; text-align: center;">STT</th>
                <th style="min-width: 190px;">Họ và Tên</th>
                <th style="width: 120px;">MSSV</th>
                <th style="width: 130px;">Vai trò</th>
                <th style="min-width: 320px;">Địa chỉ ví (Ethereum)</th>
                <th style="width: 150px;">Tình trạng nộp quỹ</th>
                <th id="thRosterAction" style="width: 80px; text-align: center;">Thao tác</th>
              </tr>
            </thead>
            <tbody id="rosterTableBody">
              <!-- Rendered via JS -->
            </tbody>
          </table>
        </div>

        <!-- Khung thông báo dành cho Ban cán sự (chỉ xem) -->
        <div id="rosterBcsViewNote"
          style="padding: 12px 16px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 12px; margin-bottom: 14px; display: none; font-size: 0.85rem; color: #1e40af; line-height: 1.5;">
          ℹ️ <strong>Quyền hạn Ban cán sự:</strong> Bạn có quyền xem toàn bộ danh bạ và theo dõi tình trạng nộp quỹ
          on-chain của từng sinh viên để đối soát. Quyền thêm mới hoặc cập nhật liên kết thông tin sinh viên thuộc thẩm
          quyền riêng của Cố vấn học tập.
        </div>

        <!-- Khung thêm/sửa sinh viên dành riêng cho Cố vấn học tập -->
        <div id="rosterAdminSection"
          style="padding: 18px 20px; background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 14px; margin-bottom: 12px; display: none;">
          <h4 id="rosterFormTitle"
            style="margin: 0 0 12px 0; color: #0f172a; font-size: 0.95rem; font-weight: 700; display: flex; align-items: center; gap: 8px;">
            <span>➕</span> Đăng ký / Cập nhật liên kết ví sinh viên (Dành riêng cho Cố vấn học tập)
          </h4>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
            <div>
              <label style="font-size: 0.8rem; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Mã
                số sinh viên (MSSV):</label>
              <input type="text" class="form-control" id="formRosterMssv" placeholder="Ví dụ: 23K4300005"
                style="width: 100%; font-size: 0.85rem; border-radius: 8px;">
            </div>
            <div>
              <label style="font-size: 0.8rem; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Họ
                và tên sinh viên:</label>
              <input type="text" class="form-control" id="formRosterName" placeholder="Ví dụ: Trần Thị Bình Dương"
                style="width: 100%; font-size: 0.85rem; border-radius: 8px;">
            </div>
          </div>
          <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 12px; margin-bottom: 14px;">
            <div>
              <label
                style="font-size: 0.8rem; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Địa chỉ
                ví Ethereum (0x...):</label>
              <input type="text" class="form-control" id="formRosterWallet" placeholder="0x..."
                style="width: 100%; font-family: monospace; font-size: 0.82rem; border-radius: 8px;">
            </div>
            <div>
              <label
                style="font-size: 0.8rem; font-weight: 600; color: #334155; display: block; margin-bottom: 4px;">Vai trò
                sinh viên:</label>
              <select class="form-control" id="formRosterRole"
                style="width: 100%; font-size: 0.85rem; border-radius: 8px;">
                <option value="student|Sinh viên">🎓 Sinh viên</option>
                <option value="bcs|Ban cán sự">⭐ Ban cán sự</option>
              </select>
            </div>
          </div>
          <div style="display: flex; gap: 10px; align-items: center;">
            <button class="btn btn-sm btn-primary" id="btnSaveRosterEntry" onclick="saveRosterEntry()"
              style="padding: 7px 16px; border-radius: 8px; font-weight: 600;">💾 Lưu vào Danh bạ K57</button>
            <button class="btn btn-sm btn-outline" id="btnCancelEditRoster" onclick="cancelEditRoster()"
              style="display: none; padding: 7px 14px; font-size: 0.82rem; cursor: pointer; border: 1px solid #cbd5e1; background: #fff; border-radius: 8px;">✕
              Hủy chỉnh sửa</button>
          </div>
        </div>
      </div>

      <!-- FOOTER -->
      <div
        style="margin-top: 14px; padding-top: 12px; border-top: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between;">
        <div style="font-size: 0.8rem; color: #64748b;" id="rosterFooterSummary">
          Đang hiển thị danh sách lớp K57
        </div>
        <button class="btn btn-secondary btn-sm" onclick="closeRosterModal()"
          style="padding: 7px 18px; font-weight: 600; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px;">
          ✕ Đóng danh bạ
        </button>
      </div>
    </div>
  </div>

  <!-- ============================================================ -->
  <!-- JAVASCRIPT LOGIC                                             -->
  <!-- ============================================================ -->
  <script>
    // --- 1. CONFIGURATION ---
    const CONFIG = {
      chainId: 11155111,
      chainIdHex: "0xaa36a7",
      chainName: "Ethereum Sepolia Testnet",
      blockExplorer: "https://sepolia.etherscan.io",
      defaultContractAddress: "0xe3e1db1da1cae10e92337c36bb13004bf984ee91",
      contractAddress: "0xe3e1db1da1cae10e92337c36bb13004bf984ee91"
    };

    // Full ProjectCore ABI
